PROFILE=production
PROVIDER_MODE=openai-compatible
PROVIDER_CREDENTIAL_MODE=static
PROVIDER_CATALOG_VALIDATION=ids
GATEWAY_PUBLIC_URL=https://ai.example.org
OIDC_ISSUER=https://sso.example.org/realms/company
OIDC_CLIENT_ID=kilo-cli
OIDC_AUDIENCE=code-ai-api
KEYCLOAK_STATUS_CLIENT_ID=gateway-status
PROVIDER_INFERENCE_BASE_URL=https://inference.example.org/v1
PROVIDER_MODELS_PATH=/models
PROVIDER_CHAT_PATH=/chat/completions
MODEL_CATALOG_FILE=builtin:y-ai
MODEL_CONTEXT=262144
MODEL_MAX_OUTPUT=4096
DATABASE_SCHEMA=public
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000
HTTP_MAX_CONNECTIONS=1024
HTTP_MAX_KEEPALIVE_CONNECTIONS=256
HTTP_POOL_TIMEOUT_SECONDS=2
IDENTITY_MAX_CONNECTIONS=32
IDENTITY_TIMEOUT_SECONDS=5
MAX_INFLIGHT_REQUESTS=512
AUTHZ_MAX_STALENESS_SECONDS=30
REQUEST_TIMEOUT_SECONDS=120
WORKER_ENABLED=false
METRICS_ENABLED=true
REQUEST_RATE=30
REQUEST_CONCURRENCY=3
DAILY_TOKEN_UNITS=1000000
TOTAL_TOKEN_UNITS=10000000
GATEWAY_CREDENTIAL_TTL_SECONDS=28800
BODY_READ_TIMEOUT_SECONDS=10
