{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "REPLACE_WITH_PLUGIN_OPENCODE_DIRECTORY",
      "options": {
        "issuer": "https://sso.example.org/realms/company",
        "gateway": "https://ai.example.org/gateway",
        "clientId": "kilo-cli",
        "dev": false,
        "openBrowser": true,
        "oidcAllowedOrigins": []
      }
    }
  ],
  "providers": {
    "y.ai": {
      "name": "Y.AI",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [],
      "settings": {
        "baseURL": "https://ai.example.org/gateway/v1"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "limit": {
            "context": 262144,
            "output": 4096
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "compatibility": {
            "supportsStore": false,
            "supportsPromptCacheKey": false,
            "maxTokensField": "max_tokens"
          }
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B",
          "limit": {
            "context": 262144,
            "output": 4096
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "compatibility": {
            "supportsStore": false,
            "supportsPromptCacheKey": false,
            "maxTokensField": "max_tokens"
          }
        }
      }
    }
  },
  "model": "y.ai/deepseek/deepseek-v4.1-flash-1017"
}
