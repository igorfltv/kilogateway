{
  "name": "@company/kilo-auth",
  "version": "0.1.0",
  "type": "module",
  "description": "Keycloak Device Flow authentication for Y.AI in Kilo and OpenCode v2",
  "files": [
    "dist",
    "README.md",
    "examples",
    "scripts/install_kilo.mjs",
    "scripts/install_opencode.mjs",
    "opencode",
    "OPENCODE.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./opencode": "./dist/opencode.js",
    "./opencode/server": "./opencode/server.js"
  },
  "bin": {
    "company-ai": "./dist/cli.js",
    "yai-install": "./scripts/install_kilo.mjs",
    "yai-install-opencode": "./scripts/install_opencode.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@kilocode/plugin": "7.8.14",
    "@opencode/plugin": "2.0.26"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
