# Server-only values. Select public addresses with YAI_ENDPOINTS_FILE.
DATABASE_URL=postgresql+asyncpg://gateway:REPLACE@postgres:5432/gateway
KEYCLOAK_STATUS_CLIENT_SECRET=REPLACE_VIA_SECRET_MECHANISM
# Default OpenAI-compatible upstream: inference service credential, not a management key.
PROVIDER_API_KEY=REPLACE_WITH_INFERENCE_SERVICE_KEY
# Optional distinct authenticated catalog; empty reuses the inference key only on the same base.
PROVIDER_CATALOG_API_KEY=
# Optional for explicit OpenRouter dev/test profiles; never distribute to clients.
OPENROUTER_MANAGEMENT_KEY=
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
ENCRYPTION_KEY_VERSION=v1
CREDENTIAL_HASH_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
ADMIN_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
GATEWAY_CREDENTIAL_TTL_SECONDS=28800
AUTHZ_MAX_STALENESS_SECONDS=30
OPENROUTER_TEST_KEY_LIMIT_USD=0.25
ENABLE_LIVE_OPENROUTER_TESTS=0
