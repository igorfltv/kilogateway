# Copy to an operator-owned file and replace addresses. This contains no credentials.
PROFILE=production
# Optional Data Center MCP connectors; leave blank to disable PAT onboarding.
JIRA_BASE_URL=
CONFLUENCE_BASE_URL=
PROVIDER_MODE=openai-compatible
PROVIDER_CREDENTIAL_MODE=static
# Standard /models guarantees IDs; model caps/tools come from the approved local catalog.
PROVIDER_CATALOG_VALIDATION=ids
GATEWAY_PUBLIC_URL=https://ai.example.org/gateway
OIDC_ISSUER=https://sso.example.org/realms/company
OIDC_CLIENT_ID=kilo-cli
OIDC_AUDIENCE=code-ai-api
# Empty means use standard discovery and its endpoints.
OIDC_DISCOVERY_URL=
OIDC_TOKEN_URL=
OIDC_DEVICE_URL=
OIDC_JWKS_URL=
KEYCLOAK_ADMIN_BASE_URL=
OIDC_ALLOWED_ORIGINS=[]
OIDC_INTERNAL_ORIGIN=
MODEL_CATALOG_FILE=builtin:y-ai
MODEL_CONTEXT=262144
MODEL_MAX_OUTPUT=4096
PROVIDER_INFERENCE_BASE_URL=https://inference.example.org/v1
# Empty uses the inference base; a separate catalog base requires its own key if authenticated.
PROVIDER_CATALOG_BASE_URL=
PROVIDER_MODELS_PATH=/models
PROVIDER_CHAT_PATH=/chat/completions
# Optional mounted trust bundle (normal TLS verification stays enabled):
TLS_CA_BUNDLE=
