# Default active local stack: generic inference transport, existing per-user key lifecycle.
PROFILE=dev
PROVISION_INFERENCE_ON_LOGIN=false
JIRA_BASE_URL=http://fake-atlassian:8091/jira
CONFLUENCE_BASE_URL=http://fake-atlassian:8091/confluence
PROVIDER_MODE=openai-compatible
PROVIDER_CREDENTIAL_MODE=openrouter-managed
PROVIDER_CATALOG_VALIDATION=metadata
GATEWAY_PUBLIC_URL=http://localhost:18000
OIDC_ISSUER=http://localhost:28080/realms/company
OIDC_CLIENT_ID=kilo-cli
OIDC_AUDIENCE=code-ai-api
OIDC_INTERNAL_ORIGIN=http://keycloak:8080
MODEL_CATALOG_FILE=builtin:y-ai
MODEL_CONTEXT=262144
MODEL_MAX_OUTPUT=4096
PROVIDER_MANAGEMENT_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_INFERENCE_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_CATALOG_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_KEYS_PATH=/keys
PROVIDER_MODELS_PATH=/models
PROVIDER_CHAT_PATH=/chat/completions
