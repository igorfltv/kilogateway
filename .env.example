# Local Compose template. Run make dev-secrets to create a private .env (0600).
# Every REPLACE value is generated locally; this file contains no working keys.
PROFILE=dev
GATEWAY_PUBLIC_URL=http://localhost:18000
OIDC_ISSUER=http://localhost:28080/realms/company
OIDC_CLIENT_ID=kilo-cli
OIDC_AUDIENCE=code-ai-api
PROVIDER_MODE=fake
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
KC_ADMIN_USER=dev-admin
KC_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DEV_USER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DEV_DENIED_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
KEYCLOAK_STATUS_CLIENT_ID=gateway-status
KEYCLOAK_STATUS_CLIENT_SECRET=REPLACE_WITH_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
ENCRYPTION_KEY_VERSION=v1
CREDENTIAL_HASH_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
ADMIN_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
FAKE_MANAGEMENT_KEY=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql+asyncpg://gateway:REPLACE@localhost:15432/gateway
FAKE_PROVIDER_URL=http://localhost:18090/v1
MODEL_CATALOG_FILE=builtin:y-ai
MODEL_CONTEXT=262144
MODEL_MAX_OUTPUT=4096
GATEWAY_CREDENTIAL_TTL_SECONDS=28800
AUTHZ_MAX_STALENESS_SECONDS=2
ENABLE_LIVE_OPENROUTER_TESTS=0
# Optional selectors; use host-side profiles for Python tools, container profiles for Compose.
YAI_ENDPOINTS_FILE=
YAI_EXTRA_SECRETS_FILE=
# External provider keys are never generated or embedded in client configs.
PROVIDER_API_KEY=
PROVIDER_CATALOG_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
